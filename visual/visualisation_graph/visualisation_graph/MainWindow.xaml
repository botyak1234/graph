<Window x:Class="visualisation_graph.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графовое приложение" Height="650" Width="900">
    <Grid>
        <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Left" Width="350" Margin="10">
            <TextBlock Text="Выберите алгоритм:" Margin="5"/>
            <ComboBox x:Name="AlgorithmSelector" Width="300" Margin="5">
                <ComboBoxItem Content="Dijkstra"/>
                <ComboBoxItem Content="BellmanFord"/>
                <ComboBoxItem Content="FloydWarshall"/>
            </ComboBox>
            <TextBlock Text="Исходная вершина:" Margin="5"/>
            <TextBox x:Name="StartVertexInput" Width="300" Margin="5"/>
            <TextBlock Text="Конечная вершина:" Margin="5"/>
            <TextBox x:Name="ParameterInput" Width="300" Margin="5"/>
            <TextBlock x:Name="ScoreText" Text="Очки: 0" FontWeight="Bold" Margin="10"/>
            <TextBlock Text="Случайный граф:" Margin="10"/>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Вершины:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="VerticesInput" Width="50" Margin="5"/>
                <TextBlock Text="Рёбра:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="EdgesInput" Width="50" Margin="5"/>
            </StackPanel>
            <Button Content="Сгенерировать" Click="GenerateGraphButton_Click" Width="300" Margin="5"/>
            <Button Content="Начать соревнование" Click="StartCompetition_Click" Width="300" Margin="5"/>
            <Button Content="Завершить выбор пути" Click="EndUserPathSelection_Click" Width="300" Margin="5"/>
            <Button Content="Начать заново" Click="ResetGraph_Click" Width="300" Margin="5"/>
            <TextBlock Text="Текущий путь:" Margin="5"/>
            <TextBlock x:Name="CurrentPathText" Text="Путь: " FontWeight="Bold" Margin="5"/>
            <TextBlock Text="Текущее время:" Margin="5"/>
            <TextBlock x:Name="CurrentTimeText" Text="Время: 0 сек" FontWeight="Bold" Margin="5"/>
            <TextBlock Text="Оценка правильности:" Margin="5"/>
            <TextBlock x:Name="AccuracyText" Text="Оценка: 0" FontWeight="Bold" Margin="5"/>
            <TextBox x:Name="OutputTextBox" Width="300" Height="100" Margin="10" VerticalAlignment="Bottom" TextWrapping="Wrap" IsReadOnly="True"/>
        </StackPanel>
        <Canvas x:Name="GraphCanvas" Background="LightGray" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="370,10,10,150"/>
    </Grid>
</Window>
